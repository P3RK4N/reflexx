{
    "cmake.buildDirectory": "${workspaceFolder}/bin",
    "cmake.configureArgs": [
        "-G", "Ninja Multi-Config",
        "-DCMAKE_TOOLCHAIN_FILE=${workspaceFolder}/cmake/clang.toolchain.cmake"
    ],
    "C_Cpp.intelliSenseEngine": "disabled",
    "clangd.path": "${workspaceFolder}/bin/clang-p2996/install/bin/clangd",
    "clangd.arguments": 
    [
        "--compile-commands-dir=${workspaceFolder}/bin",
        "-log=verbose", 
        "-pretty", 
        "--background-index"
    ],
}
