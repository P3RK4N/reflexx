{
    "cmake.buildDirectory": "${workspaceFolder}/bin",
    "cmake.configureArgs": [
        "-DCMAKE_TOOLCHAIN_FILE=./deps/clang.toolchain.cmake"
    ],
    "C_Cpp.intelliSenseEngine": "disabled",
    "clangd.path": "${workspaceFolder}/deps/clang-p2996-x86_64-unknown-linux-gnu/bin/clangd",
    "clangd.arguments": 
    [
        "--compile-commands-dir=${workspaceFolder}/bin",
        "-log=verbose", 
        "-pretty", 
        "--background-index"
    ]
}